---
import Layout from "../layouts/Layout.astro";
import ContactoForm from "../components/ContactoForm";
import { NEGOCIO, SUCURSALES } from "../consts";
import { configuracionSitio } from "../data/configuracion";
import { negocioJsonLd } from "../lib/seo";

// Embed de Google Maps sin necesitar API key: el formato "?q=<dirección>
// &output=embed" es público y puede vivir en un <iframe> directo, a
// diferencia del link corto share.google (NEGOCIO.mapsUrl) que solo sirve
// como enlace "Abrir en Google Maps", no como iframe embebible.
const direccionMapa = `${SUCURSALES[0].direccion}, Perú`;
const mapaEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(direccionMapa)}&output=embed`;
// Deep link de Waze sin API key — mismo criterio que el embed de Maps de
// arriba: un formato público que no depende de ningún servicio pago.
const wazeUrl = `https://waze.com/ul?q=${encodeURIComponent(direccionMapa)}&navigate=yes`;

const heroImagen = "/images/hero/auto-real.webp";

// Un solo local — se muestra como una única tarjeta de contacto, sin
// enmarcarlo como "sucursales" (esa palabra solo tiene sentido si hay más
// de una). Si en el futuro se abre otra tienda, vuelve a valer la pena un
// .map() sobre SUCURSALES.
const tienda = SUCURSALES[0];
const DATOS = [
  { titulo: tienda.nombre, texto: tienda.direccion, icono: '<path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/>' },
  { titulo: "Horario", texto: tienda.horario, icono: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' },
  { titulo: "Tel", texto: tienda.telefono, enlace: `tel:${tienda.telefono.replace(/\s/g, "")}`, icono: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>' },
  { titulo: "Correo", texto: NEGOCIO.correo, enlace: `mailto:${NEGOCIO.correo}`, icono: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>' },
];
const svg = (trazos: string, clase = "h-5 w-5") =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="${clase}" aria-hidden="true">${trazos}</svg>`;
const botonMapa =
  "inline-flex items-center gap-2 rounded-md border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition-colors duration-200 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800";
---

<Layout
  title="Contacto"
  description={`Contacta a SKY Group por WhatsApp ${NEGOCIO.telefono} o visítanos en ${SUCURSALES[0].direccion}. Horario: ${SUCURSALES[0].horario}.`}
  datosEstructurados={negocioJsonLd()}
>
  <section class="relative isolate overflow-hidden bg-white dark:bg-neutral-950">
    <img src={heroImagen} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover object-right" />
    <div class="absolute inset-0 -z-10 bg-white/85 sm:hidden dark:bg-neutral-950/85"></div>
    <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-white from-35% via-white/80 to-white/0 sm:block dark:from-neutral-950 dark:via-neutral-950/80 dark:to-neutral-950/10"></div>
    <div class="mx-auto max-w-6xl px-4 pb-28 pt-16 sm:pb-40 sm:pt-24">
      <h1 class="bg-gradient-to-r from-brand-blue-dark to-brand-green-dark bg-clip-text pb-1 text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl lg:text-6xl dark:from-brand-blue dark:to-brand-green">Contacto</h1>
    </div>
  </section>

  <section class="mx-auto -mt-16 max-w-6xl px-4 sm:-mt-24">
    <div class="grid gap-6 lg:grid-cols-[2fr_3fr]">
      <div data-reveal class="flex flex-col rounded-lg border border-neutral-200 bg-neutral-50 p-6 shadow-xl sm:p-8 dark:border-neutral-800 dark:bg-neutral-900">
        <ul class="space-y-6">
          {
            DATOS.map((d, i) => (
              <li class="flex gap-4">
                <span
                  class={`flex h-11 w-11 flex-none items-center justify-center rounded-full text-white shadow-md ${i % 2 === 0 ? "bg-brand-blue" : "bg-brand-green"}`}
                  set:html={svg(d.icono)}
                />
                <div class="min-w-0">
                  <p class="font-semibold text-neutral-900 dark:text-white">{d.titulo}</p>
                  {d.enlace ? (
                    <a href={d.enlace} class="mt-0.5 block break-words text-sm text-neutral-600 hover:text-brand-blue-dark hover:underline dark:text-neutral-300 dark:hover:text-white">{d.texto}</a>
                  ) : (
                    <p class="mt-0.5 text-sm text-neutral-600 dark:text-neutral-300">{d.texto}</p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <a
          href={`https://wa.me/${configuracionSitio.whatsappNumero}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-green-600 px-5 py-3 text-sm font-semibold text-white transition-transform hover:scale-105 hover:bg-green-700 active:scale-95 lg:mt-auto"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
          Escribir por WhatsApp
        </a>
      </div>

      <div data-reveal style="transition-delay: 120ms" class="rounded-lg border border-neutral-200 bg-white p-6 shadow-xl sm:p-8 dark:border-neutral-800 dark:bg-neutral-900">
        <h2 class="text-2xl font-bold tracking-tight text-brand-blue-dark sm:text-3xl dark:text-brand-blue">Escríbenos</h2>
        <div class="mt-4">
          <ContactoForm client:visible />
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <h2 class="flex items-center gap-2 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-blue text-white shadow-md" set:html={svg(DATOS[0].icono, "h-5 w-5")} />
      Ubicación
    </h2>
    <div class="mt-4 overflow-hidden rounded-lg border border-neutral-200 shadow-sm dark:border-neutral-800">
      <iframe
        src={mapaEmbedUrl}
        width="100%"
        height="400"
        style="border:0; display:block"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación de SKY Group en el mapa"
      ></iframe>
    </div>
    <div class="mt-4 flex flex-wrap gap-3">
      <a href={NEGOCIO.mapsUrl} target="_blank" rel="noopener noreferrer" class={botonMapa}>
        <span class="text-brand-blue-dark dark:text-brand-blue" set:html={svg(DATOS[0].icono, "h-4 w-4")} />
        Abrir en Google Maps
      </a>
      <a href={wazeUrl} target="_blank" rel="noopener noreferrer" class={botonMapa}>
        <span class="text-brand-blue-dark dark:text-brand-blue" set:html={svg('<polygon points="3 11 22 2 13 21 11 13 3 11"/>', "h-4 w-4")} />
        Abrir en Waze
      </a>
    </div>
  </section>
</Layout>
