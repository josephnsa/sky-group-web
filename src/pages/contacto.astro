---
import Layout from "../layouts/Layout.astro";
import ContactoForm from "../components/ContactoForm";
import { NEGOCIO, SUCURSALES } from "../consts";

// Embed de Google Maps sin necesitar API key: el formato "?q=<dirección>
// &output=embed" es público y puede vivir en un <iframe> directo, a
// diferencia del link corto share.google (NEGOCIO.mapsUrl) que solo sirve
// como enlace "Abrir en Google Maps", no como iframe embebible.
const direccionMapa = `${SUCURSALES[0].direccion}, Perú`;
const mapaEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(direccionMapa)}&output=embed`;
---

<Layout title="Contacto">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:text-5xl">Contacto</h1>

    {
      /* Un solo local — se muestra como una única tarjeta de contacto, sin
      enmarcarlo como "sucursales" (esa palabra solo tiene sentido si hay
      más de una). Si en el futuro se abre otra tienda, ahí sí vuelve a
      valer la pena volver a un .map() sobre SUCURSALES. */
    }
    <div class="mt-8 rounded-lg border-l-4 border-l-brand-blue border-y border-r border-y-neutral-200 border-r-neutral-200 p-5 dark:border-y-neutral-800 dark:border-r-neutral-800 dark:bg-neutral-900">
      <p class="font-semibold text-neutral-900 dark:text-white">{SUCURSALES[0].nombre}</p>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{SUCURSALES[0].direccion}</p>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Horario: {SUCURSALES[0].horario}</p>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Tel: {SUCURSALES[0].telefono}</p>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Correo: {NEGOCIO.correo}</p>
      <a
        href={`https://wa.me/${NEGOCIO.whatsappNumero}`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block rounded-md bg-green-600 px-5 py-2 text-sm font-semibold text-white hover:bg-green-700"
      >
        Escribir por WhatsApp
      </a>
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Escríbenos</h2>
      <div class="mt-4">
        <ContactoForm client:visible />
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Ubicación</h2>
      <div class="mt-4 overflow-hidden rounded-lg border border-neutral-200 dark:border-neutral-800">
        <iframe
          src={mapaEmbedUrl}
          width="100%"
          height="360"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de SKY Group en el mapa"
        />
      </div>
    </div>
  </section>
</Layout>
