---
import Layout from "../layouts/Layout.astro";
import { NEGOCIO } from "../consts";

// Contenido: "ENVIOS A TODO EL PERU - INFO OK.docx" (carpeta PAG WEB SKY).
// El documento pide que "se vea visual y bonito y con información al mismo
// tiempo": portada con foto, datos clave, pestañas Clientes / Distribuidores
// y el envío a provincias como un recorrido en pasos. Mismo lenguaje visual
// que /garantias.

const WHATSAPP = `https://wa.me/${NEGOCIO.whatsappNumero}?text=${encodeURIComponent("Hola SKY Group, quisiera consultar sobre el envío de un pedido.")}`;

const DATOS = [
  { valor: "Gratis", titulo: "Retiro en tienda", desc: "Av. México 1028, La Victoria, Lima." },
  { valor: "4:00 pm", titulo: "Despacho el mismo día", desc: "Con pago confirmado hasta esa hora." },
  { valor: "S/ 0", titulo: "Recargo hasta la agencia", desc: "El flete se paga en destino." },
  { valor: "Todo el Perú", titulo: "Lima y provincias", desc: "Reparto propio, courier y agencias." },
];

// Envío nacional (igual para clientes y distribuidores, según el documento).
const NACIONAL = [
  { titulo: "Confirmas el pago", desc: "El pago del producto debe estar confirmado para proceder con el envío." },
  { titulo: "Despachamos", desc: "Con pago confirmado hasta las 4:00 pm, sale el mismo día. Después, queda sujeto a disponibilidad y cobertura de reparto." },
  { titulo: "Llevamos a tu agencia", desc: "A la agencia de transporte de tu preferencia, sin recargo adicional." },
  { titulo: "Recibes y pagas el flete", desc: "El flete se paga en destino, directamente a la agencia." },
];

const LIMA_CLIENTES = [
  { titulo: "Reparto en Lima", desc: "Entrega con nuestro transporte o servicio de reparto dentro de Lima Metropolitana, coordinada según disponibilidad y área de cobertura.", icono: "camion" },
  { titulo: "Courier o app de envío", desc: "Para pedidos urgentes o de menor volumen: solicitas tu propio courier para recoger el pedido, previo pago. Enviamos imágenes al momento de la entrega.", icono: "moto" },
  { titulo: "Retiro en tienda gratis", desc: "Recoge tu pedido sin costo en nuestro local de Avenida México 1028, La Victoria, Lima.", icono: "tienda", destacado: true },
];

const ZONAS = ["Lima Norte", "Lima Sur", "Lima Centro", "Lima Este", "Otras zonas de Lima"];
---

<Layout title="Envíos a todo el Perú" description="Modalidades de entrega de SKY Group en Lima y provincias, para clientes y distribuidores">
  {/* ===== Portada ===== */}
  <section class="relative isolate overflow-hidden bg-neutral-950 text-white">
    <img src="/images/envios/portada.webp" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-60" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-neutral-950 via-neutral-950/85 to-neutral-950/10" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-green">Distribución nacional</p>
      <h1 class="mt-3 max-w-2xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
        Envíos a{" "}
        <span class="bg-gradient-to-r from-brand-blue to-brand-green bg-clip-text text-transparent">todo el Perú</span>
      </h1>
      <span class="mt-5 block h-1 w-20 rounded-full bg-gradient-to-r from-brand-blue to-brand-green" aria-hidden="true"></span>
      <p class="mt-5 max-w-xl text-lg text-white/85">
        Llegamos a Lima y provincias con diferentes modalidades de despacho, según el tipo de compra, la zona y la urgencia de tu pedido.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#modalidades" class="inline-flex items-center gap-2 rounded-md bg-brand-blue px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-blue/30 transition-transform hover:scale-105 active:scale-95">
          Ver modalidades de entrega
        </a>
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-white/40 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  {/* ===== Datos clave ===== */}
  <section class="relative z-10 mx-auto -mt-10 max-w-6xl px-4">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        DATOS.map((d, i) => (
          <li data-reveal style={`transition-delay: ${i * 90}ms`} class={`rounded-xl border-t-4 bg-white p-5 shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:bg-neutral-900 ${i % 2 === 0 ? "border-t-brand-blue" : "border-t-brand-green"}`}>
            <p class={`text-3xl font-extrabold tracking-tight ${i % 2 === 0 ? "text-brand-blue-dark dark:text-brand-blue" : "text-brand-green-dark dark:text-brand-green"}`}>{d.valor}</p>
            <p class="mt-1 font-bold text-neutral-900 dark:text-white">{d.titulo}</p>
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{d.desc}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 flex items-start gap-3 rounded-lg border border-brand-blue/20 bg-brand-blue/5 px-4 py-3 text-sm text-neutral-700 dark:text-neutral-300">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 h-5 w-5 flex-none text-brand-blue" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
      <span><b class="text-neutral-900 dark:text-white">A considerar:</b> las modalidades de despacho pueden variar según destino, volumen del pedido, agencia disponible y programación de rutas dentro de nuestra área de cobertura.</span>
    </p>
  </section>

  {/* ===== Pestañas Clientes / Distribuidores ===== */}
  <section id="modalidades" class="mx-auto max-w-6xl scroll-mt-40 px-4 py-16 sm:py-20">
    <span class="block h-1 w-12 rounded-full bg-gradient-to-r from-brand-blue to-brand-green" aria-hidden="true"></span>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white">Modalidades de entrega</h2>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">Elige tu caso: atendemos a clientes y a distribuidores con opciones distintas.</p>

    <div role="tablist" aria-label="Tipo de cliente" class="mt-6 inline-flex rounded-full bg-neutral-100 p-1 dark:bg-neutral-900" data-pestanas>
      <button type="button" role="tab" id="tab-clientes" aria-controls="panel-clientes" aria-selected="true" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors aria-selected:bg-brand-blue aria-selected:text-white aria-[selected=false]:text-neutral-600 dark:aria-[selected=false]:text-neutral-400">
        Clientes
      </button>
      <button type="button" role="tab" id="tab-distribuidores" aria-controls="panel-distribuidores" aria-selected="false" tabindex="-1" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors aria-selected:bg-brand-blue aria-selected:text-white aria-[selected=false]:text-neutral-600 dark:aria-[selected=false]:text-neutral-400">
        Distribuidores
      </button>
    </div>

    {/* --- Clientes --- */}
    <div role="tabpanel" id="panel-clientes" aria-labelledby="tab-clientes" class="mt-8">
      <h3 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Entregas en Lima</h3>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {
          LIMA_CLIENTES.map((m) => (
            <article class={`rounded-xl border p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${m.destacado ? "border-brand-green/50 bg-brand-green/5 dark:bg-brand-green/10" : "border-neutral-200 dark:border-neutral-800"}`}>
              <span class={`flex h-12 w-12 items-center justify-center rounded-full text-white ${m.destacado ? "bg-brand-green-dark" : "bg-brand-blue"}`}>
                {m.icono === "camion" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>}
                {m.icono === "moto" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><circle cx="5.5" cy="16.5" r="3" /><circle cx="18.5" cy="16.5" r="3" /><path d="M5.5 16.5 9 10h5l2.5 6.5M14 10l-1-3h3" /></svg>}
                {m.icono === "tienda" && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M4 9 5.5 4h13L20 9M4 9h16v11H4zM9 20v-6h6v6" /></svg>}
              </span>
              <h4 class="mt-4 font-bold text-neutral-900 dark:text-white">{m.titulo}</h4>
              <p class="mt-1.5 text-sm text-neutral-600 dark:text-neutral-400">{m.desc}</p>
              {m.destacado && <span class="mt-3 inline-block rounded-full bg-brand-green-dark px-2.5 py-0.5 text-xs font-bold text-white">Sin costo</span>}
            </article>
          ))
        }
      </div>
    </div>

    {/* --- Distribuidores --- */}
    <div role="tabpanel" id="panel-distribuidores" aria-labelledby="tab-distribuidores" class="mt-8" hidden>
      <p class="text-neutral-700 dark:text-neutral-300">
        Brindamos soluciones de despacho adaptadas a tus necesidades, de acuerdo con el volumen del pedido, ubicación y requerimientos de entrega.
      </p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <article class="rounded-xl border border-neutral-200 p-5 dark:border-neutral-800">
          <h3 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Distribución en Lima</h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            Pedidos de atención inmediata: se coordinan directamente con tu asesor de ventas autorizado. Para pedidos de menor volumen
            que requieran rapidez: recojo en nuestro local o courier (apps de envío) coordinado con el distribuidor.
          </p>
        </article>
        <article class="rounded-xl border border-brand-blue/30 bg-brand-blue/5 p-5 dark:bg-brand-blue/10">
          <h3 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Envíos programados</h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            Reparto periódico a determinadas zonas de Lima diariamente, programado según zona y disponibilidad:
          </p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Zonas de reparto programado">
            {ZONAS.map((z) => <li class="rounded-full bg-white px-3 py-1 text-xs font-bold text-brand-blue-dark shadow-sm dark:bg-neutral-900 dark:text-brand-blue">{z}</li>)}
          </ul>
          <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-400">Se coordinan directamente con tu asesor de ventas autorizado.</p>
        </article>
      </div>
    </div>

    {/* --- Nacional: igual para ambos --- */}
    <div class="mt-12 rounded-2xl bg-neutral-50 p-6 sm:p-8 dark:bg-neutral-900">
      <h3 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Envíos a provincias</h3>
      <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Mediante la agencia de transporte de tu preferencia (o la que indique el distribuidor).</p>
      <ol class="relative mt-8 grid gap-6 md:grid-cols-4">
        <span class="absolute left-[1.35rem] top-6 hidden h-0.5 w-[calc(100%-2.7rem)] bg-gradient-to-r from-brand-blue/40 via-brand-green/40 to-brand-blue/40 md:block" aria-hidden="true"></span>
        {
          NACIONAL.map((p, i) => (
            <li data-reveal style={`transition-delay: ${i * 120}ms`} class="relative flex gap-4 md:block">
              <span class={`relative z-10 flex h-11 w-11 flex-none items-center justify-center rounded-full text-sm font-extrabold text-white ring-4 ring-neutral-50 dark:ring-neutral-900 ${i % 2 === 0 ? "bg-brand-blue" : "bg-brand-green-dark"}`}>
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="md:mt-4">
                <h4 class="font-bold text-neutral-900 dark:text-white">{p.titulo}</h4>
                <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{p.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ===== Responsabilidad del transporte ===== */}
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="flex gap-4 rounded-xl border border-amber-300/60 bg-amber-50 p-5 text-sm text-neutral-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-neutral-300">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 flex-none text-amber-600" aria-hidden="true"><path d="M12 3 2 20h20Z" /><path d="M12 10v4M12 17h.01" /></svg>
      <div>
        <p class="font-semibold text-neutral-900 dark:text-white">Sobre el transporte por agencia</p>
        <p class="mt-1.5">
          SKY GROUP no se responsabiliza por daños ocasionados durante el transporte de los productos por la agencia solicitada por el
          cliente o distribuidor. Nuestros envíos se realizan de manera cuidadosa, con los rotulados respectivos, para brindar la mayor
          seguridad y garantizar que los productos lleguen en el mejor estado. Por lo tanto, no asumimos responsabilidad por daños o el
          mal estado de los productos debido a malas prácticas de las agencias de transporte.
        </p>
      </div>
    </div>
  </section>

  {/* ===== Franja final ===== */}
  <section class="relative isolate overflow-hidden bg-neutral-950 text-white">
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-blue-dark/40 via-neutral-950 to-brand-green-dark/30" aria-hidden="true"></div>
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-xl font-extrabold tracking-tight">¿Tienes dudas sobre el envío a tu ciudad?</p>
        <p class="mt-1 text-sm text-white/75">Escríbenos y te confirmamos la modalidad, el costo y el tiempo estimado.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-white transition-transform hover:scale-105 active:scale-95">
          Consultar por WhatsApp
        </a>
        <a href="/contacto" class="inline-flex items-center gap-2 rounded-full border border-white/50 px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-white transition-colors hover:bg-white/10">
          Contactar a SKY Group
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pestañas Clientes / Distribuidores (accesibles: clic y flechas del teclado).
  // Se engancha en cada carga de página porque el sitio usa transiciones
  // de Astro (ClientRouter).
  function iniciarPestanas() {
    const lista = document.querySelector("[data-pestanas]");
    if (!lista || lista.hasAttribute("data-listo")) return;
    lista.setAttribute("data-listo", "");
    const tabs = Array.from(lista.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activar = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const activo = t === tab;
        t.setAttribute("aria-selected", String(activo));
        t.tabIndex = activo ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !activo;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => activar(t));
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const sig = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        activar(sig);
        sig.focus();
      });
    });
  }
  document.addEventListener("astro:page-load", iniciarPestanas);
  iniciarPestanas();
</script>
