---
import Layout from "../layouts/Layout.astro";
import { configuracionSitio as c } from "../data/configuracion";

const TEXTO_DEFECTO =
  "Coordinamos el envío de tu pedido a todo el Perú. En Lima, la entrega se coordina directamente por WhatsApp según tu distrito. Para provincias, trabajamos con agencias de transporte — el costo y tiempo de entrega dependen del destino y del tamaño del pedido, y se confirman al armar tu cotización.";
const texto = c.enviosTexto || TEXTO_DEFECTO;
const imagenes = [c.enviosImagen1, c.enviosImagen2].filter(Boolean) as string[];
---

<Layout title="Envíos a todo el Perú" description="Detalle de envíos de SKY Group a Lima y provincias">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:text-5xl">
      Envíos a todo el Perú
    </h1>
    <p class="mt-4 whitespace-pre-line text-neutral-700 dark:text-neutral-400">{texto}</p>

    {
      imagenes.length > 0 && (
        <div class={`mt-8 grid gap-4 ${imagenes.length > 1 ? "sm:grid-cols-2" : ""}`}>
          {imagenes.map((img) => (
            <img src={img} alt="" class="w-full rounded-lg border border-neutral-200 object-cover dark:border-neutral-800" loading="lazy" />
          ))}
        </div>
      )
    }

    <p class="mt-8 text-sm text-neutral-500 dark:text-neutral-400">
      ¿Tienes dudas sobre el envío a tu ciudad? Escríbenos por WhatsApp y te confirmamos costo y tiempo estimado.
    </p>
  </section>
</Layout>
