---
import Layout from "../../layouts/Layout.astro";
import CatalogoInteractivo from "../../components/CatalogoInteractivo";
import { getCategorias, productos } from "../../data/catalog";

const categorias = getCategorias().map((c) => c.categoria);
---

<Layout title="Catálogo">
  <div class="border-b border-neutral-200 bg-gradient-to-r from-brand-blue/10 to-brand-green/10 dark:border-neutral-800 dark:from-brand-blue/5 dark:to-brand-green/5">
    <div class="mx-auto max-w-7xl px-4 py-10">
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:text-5xl">Catálogo</h1>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400">{productos.length} productos disponibles en todas las categorías.</p>
    </div>
  </div>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:py-12">
    <CatalogoInteractivo client:load productos={productos} categorias={categorias} />
  </section>
</Layout>
