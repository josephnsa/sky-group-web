---
import Layout from "../layouts/Layout.astro";
import { configuracionSitio as c } from "../data/configuracion";
import { TEXTO_MAYORISTA_DEFECTO, VIDEO_MAYORISTA_DEFECTO, VIDEO_TIENDA_DEFECTO } from "../data/textos-defecto";
import { youtubeEmbedUrl } from "../lib/youtube";
import VideoYoutube from "../components/VideoYoutube.astro";
import VideoTiktok from "../components/VideoTiktok.astro";
import { videoEmbebible } from "../lib/enlaces";

// Números específicos de esta página (distintos al WhatsApp general del
// resto del sitio) — tienda tiene uno, ventas al por mayor tiene dos.
const NUMERO_TIENDA = "51922555680";
const NUMEROS_MAYORISTA = ["51922555680", "51963323363"];

function linkWhatsapp(numero: string, mensaje: string) {
  return `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
}

const linkTienda = linkWhatsapp(NUMERO_TIENDA, "Hola, quisiera hacer una consulta.");


const textoMayorista = c.atencionMayoristaTexto || TEXTO_MAYORISTA_DEFECTO;



// El campo del panel acepta enlaces de YouTube o de TikTok.
const urlTienda = c.atencionTiendaYoutube || VIDEO_TIENDA_DEFECTO;
const urlMayorista = c.atencionMayoristaYoutube || VIDEO_MAYORISTA_DEFECTO;
const tiktok = (url: string) => {
  const v = videoEmbebible(url);
  return v?.plataforma === "TikTok" ? v.embedUrl : null;
};
const tiktokTienda = tiktok(urlTienda);
const tiktokMayorista = tiktok(urlMayorista);
const embedTienda = tiktokTienda ? null : youtubeEmbedUrl(urlTienda);
const embedMayorista = tiktokMayorista ? null : youtubeEmbedUrl(urlMayorista);
---

<Layout title="Atención por WhatsApp" description="Cotiza y compra directo por WhatsApp con SKY Group: atención en tienda y ventas al por mayor, con envíos a todo el Perú.">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:text-5xl">
      Atención por WhatsApp
    </h1>

    <div class="mt-8 rounded-lg border border-neutral-200 p-5 dark:border-neutral-800">
      <p class="font-semibold text-neutral-900 dark:text-white">Atención en tienda</p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
        Cotiza y compra directo, sin formularios largos. Escríbenos con el
        producto que te interesa y te ayudamos a coordinar todo por WhatsApp.
      </p>
      {
        tiktokTienda ? (
          <VideoTiktok embed={tiktokTienda} enlace={urlTienda} titulo="Video de atención en tienda" />
        ) : (
          embedTienda && <VideoYoutube embed={embedTienda} titulo="Video de atención en tienda" />
        )
      }
      <a
        href={linkTienda}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 rounded-md bg-green-600 px-6 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-green-700"
      >
        Escribir por WhatsApp
      </a>
    </div>

    <div class="mt-6 rounded-lg border border-neutral-200 p-5 dark:border-neutral-800">
      <p class="font-semibold text-neutral-900 dark:text-white">Atención al por mayor</p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{textoMayorista}</p>
      {
        tiktokMayorista ? (
          <VideoTiktok embed={tiktokMayorista} enlace={urlMayorista} titulo="Video de atención al por mayor" />
        ) : (
          embedMayorista && <VideoYoutube embed={embedMayorista} titulo="Video de atención al por mayor" />
        )
      }
      <div class="mt-4 flex flex-wrap gap-3">
        {
          NUMEROS_MAYORISTA.map((num) => (
            <a
              href={linkWhatsapp(num, "Hola, quisiera información para compra al por mayor.")}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md border border-green-600 px-5 py-2.5 text-sm font-semibold text-green-700 transition-colors duration-200 hover:bg-green-50 dark:text-green-400 dark:hover:bg-green-950/40"
            >
              Consultar por mayor · +{num.slice(0, 2)} {num.slice(2, 5)} {num.slice(5, 8)} {num.slice(8)}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
