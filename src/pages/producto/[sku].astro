---
import Layout from "../../layouts/Layout.astro";
import AddToCartButton from "../../components/AddToCartButton";
import { IconWhatsapp } from "../../components/icons/ui";
import { getImagenProducto, productos, slugify } from "../../data/catalog";
import { NEGOCIO } from "../../consts";

export function getStaticPaths() {
  return productos.map((p) => ({
    params: { sku: p.sku },
    props: { producto: p },
  }));
}

const { producto } = Astro.props;
const tieneDescuento =
  producto.precio != null && producto.precioAnterior != null && producto.precioAnterior > producto.precio;
const enlaceCotizar = `https://wa.me/${NEGOCIO.whatsappNumero}?text=${encodeURIComponent(
  `Hola, quisiera cotizar: ${producto.nombre} (${producto.sku})`,
)}`;
---

<Layout title={producto.nombre} description={producto.descripcion}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <nav class="text-sm text-neutral-500 dark:text-neutral-400">
      <a href="/catalogo" class="hover:underline">Catálogo</a> /{" "}
      <a href={`/catalogo/${slugify(producto.categoria)}`} class="hover:underline">
        {producto.categoria}
      </a>{" "}
      / {producto.nombre}
    </nav>

    <div class="mt-6 grid gap-8 sm:grid-cols-2">
      <img
        src={getImagenProducto(producto)}
        alt={producto.nombre}
        class="w-full rounded-lg border border-neutral-200 object-cover dark:border-neutral-800"
      />

      <div>
        <p class="text-xs uppercase tracking-wide text-neutral-500 dark:text-neutral-400">
          {producto.marca}
        </p>
        <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-3xl">
          {producto.nombre}
        </h1>
        <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">Código: {producto.sku}</p>

        {
          producto.precio != null && (
            <div class="mt-4 flex items-baseline gap-3">
              <span class="text-2xl font-bold text-neutral-900 dark:text-white">
                S/ {producto.precio.toFixed(2)}
              </span>
              {tieneDescuento && (
                <span class="text-lg text-neutral-400 line-through dark:text-neutral-500">
                  S/ {producto.precioAnterior!.toFixed(2)}
                </span>
              )}
            </div>
          )
        }

        <p class="mt-4 text-neutral-700 dark:text-neutral-300">{producto.descripcion}</p>

        <div class="mt-6 max-w-xs">
          {
            producto.precio != null ? (
              <AddToCartButton client:load sku={producto.sku} />
            ) : (
              <a
                href={enlaceCotizar}
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center gap-2 rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-green-700 active:scale-[0.98]"
              >
                <IconWhatsapp class="h-4 w-4" />
                Cotiza por WhatsApp
              </a>
            )
          }
        </div>

        {
          producto.compatibilidad && producto.compatibilidad.length > 0 && (
            <div class="mt-8">
              <p class="text-sm font-semibold text-neutral-900 dark:text-white">Compatible con</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {producto.compatibilidad.map((modelo) => (
                  <span class="rounded-full border border-neutral-300 px-3 py-1 text-xs text-neutral-700 dark:border-neutral-700 dark:text-neutral-300">
                    {modelo}
                  </span>
                ))}
              </div>
            </div>
          )
        }

        {
          producto.especificaciones && producto.especificaciones.length > 0 && (
            <div class="mt-8">
              <p class="text-sm font-semibold text-neutral-900 dark:text-white">Ficha técnica</p>
              <dl class="mt-2 divide-y divide-neutral-200 rounded-lg border border-neutral-200 text-sm dark:divide-neutral-800 dark:border-neutral-800">
                {producto.especificaciones.map((spec) => (
                  <div class="flex justify-between gap-4 px-4 py-2.5">
                    <dt class="text-neutral-500 dark:text-neutral-400">{spec.etiqueta}</dt>
                    <dd class="text-right font-medium text-neutral-900 dark:text-neutral-100">{spec.valor}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Layout>
