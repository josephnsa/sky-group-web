---
import Layout from "../layouts/Layout.astro";
import MarcasSection from "../components/MarcasSection.astro";
import { configuracionSitio as c } from "../data/configuracion";
import { HISTORIA_DEFECTO, MISION_DEFECTO, VALORES_DEFECTO, VISION_DEFECTO } from "../data/textos-defecto";

// Misión, Visión, Valores e Historia: texto real de "PRESENTACION SKY
// GROUP 2026.pptx" (diapositivas 5, 6 y 7) — usado como fallback si nadie
// editó estos campos todavía desde /admin/configuracion.




const mision = c.mision || MISION_DEFECTO;
const vision = c.vision || VISION_DEFECTO;
const historia = c.historia || HISTORIA_DEFECTO;

// Imágenes referenciales, fijas por ahora — el negocio las va a reemplazar
// directamente subiendo sus propias fotos a estas rutas (no editable desde
// el admin a propósito, para mantener esto simple).
const misionImagen = "/images/categorias/equipamiento-exterior.webp";
const visionImagen = "/images/hero/auto-real.webp";
const historiaImagen = "/images/nosotros/fachada.webp";


const VALORES = c.valores && c.valores.length > 0 ? c.valores : VALORES_DEFECTO;

// "¿Por qué SKY?" — los 6 bloques visuales que pide la presentación
// (diapositiva 17), con descripciones tal cual las trae la fuente donde
// las hay.
const RAZONES = [
  { titulo: "Amplio portafolio de productos", desc: "Productos y soluciones para diferentes tipos de vehículos." },
  { titulo: "Atención personalizada", desc: "Asesoría para ayudarte a encontrar el producto adecuado." },
  { titulo: "Calidad y funcionalidad", desc: "Productos seleccionados para responder a diferentes necesidades." },
  { titulo: "Venta mayorista y minorista", desc: "Atendemos tanto a clientes particulares como a negocios y distribuidores." },
  { titulo: "Distribución nacional", desc: "Distribuimos nuestros productos a todo el Perú y fronteras." },
  { titulo: "Experiencia en el sector automotriz", desc: "Trayectoria dedicada al mercado automotriz peruano." },
];
---

<Layout title="Nosotros" description="Conoce a SKY Group: misión, visión, valores e historia de la empresa importadora de accesorios y equipamiento vehicular en Lima, Perú.">
  <section class="bg-gradient-to-br from-brand-blue to-brand-green">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center text-white sm:py-24">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">Nosotros</h1>
      <p class="mt-3 text-white/90">
        Somos una empresa peruana líder en la importación, comercialización
        y distribución de accesorios y equipamiento para vehículos, con
        atención directa y personalizada por WhatsApp para clientes
        mayoristas y minoristas.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-5xl gap-6 px-4 py-12 sm:grid-cols-2 sm:py-16">
    <div data-reveal class="overflow-hidden rounded-lg border-t-4 border-t-brand-blue border-x border-b border-x-neutral-200 border-b-neutral-200 dark:border-x-neutral-800 dark:border-b-neutral-800 dark:bg-neutral-900">
      <img src={misionImagen} alt="Camioneta con equipamiento exterior SKY Group" class="h-36 w-full object-cover" loading="lazy" />
      <div class="p-6">
        <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Misión</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{mision}</p>
      </div>
    </div>
    <div data-reveal style="transition-delay: 120ms" class="overflow-hidden rounded-lg border-t-4 border-t-brand-green border-x border-b border-x-neutral-200 border-b-neutral-200 dark:border-x-neutral-800 dark:border-b-neutral-800 dark:bg-neutral-900">
      <img src={visionImagen} alt="Auto equipado con accesorios" class="h-36 w-full object-cover" loading="lazy" />
      <div class="p-6">
        <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">Visión</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{vision}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 sm:pb-16">
    <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <h2 class="border-l-4 border-brand-green pl-3 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Nuestra historia</h2>
        <p data-reveal class="mt-4 max-w-3xl text-sm text-neutral-600 dark:text-neutral-400">{historia}</p>
      </div>
      <img
        src={historiaImagen}
        alt="Fachada de la tienda SKY Group en Av. México, La Victoria"
        class="h-40 w-full rounded-lg object-cover sm:h-32 sm:w-48"
        loading="lazy"
      />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 sm:pb-16">
    <h2 class="border-l-4 border-brand-blue pl-3 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Valores</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        VALORES.map((v, i) => (
          <div data-reveal style={`transition-delay: ${i * 100}ms`} class="overflow-hidden rounded-lg bg-neutral-50 dark:bg-neutral-900">
            {v.imagen ? (
              <img src={v.imagen} alt="" class="h-32 w-full object-cover" loading="lazy" />
            ) : (
              <span
                class={`mt-5 ml-5 block h-1.5 w-8 rounded-full ${
                  i % 3 === 0 ? "bg-brand-blue" : i % 3 === 1 ? "bg-brand-green" : "bg-brand-gray"
                }`}
              />
            )}
            <div class="p-5 pt-3">
              <p class="font-semibold text-neutral-900 dark:text-white">{v.titulo}</p>
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{v.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12 sm:pb-16">
    <h2 class="border-l-4 border-brand-green pl-3 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">¿Por qué elegirnos?</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        RAZONES.map((r, i) => (
          <div data-reveal style={`transition-delay: ${i * 90}ms`} class="flex gap-3 rounded-lg border border-neutral-200 p-4 dark:border-neutral-800">
            <span class={`mt-1 h-2 w-2 flex-none rounded-full ${i % 2 === 0 ? "bg-brand-blue" : "bg-brand-green"}`} />
            <div>
              <p class="font-semibold text-neutral-900 dark:text-white">{r.titulo}</p>
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{r.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <MarcasSection />
</Layout>
