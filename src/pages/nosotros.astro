---
import Layout from "../layouts/Layout.astro";
import MarcasSection from "../components/MarcasSection.astro";
import { IconBox, IconChat, IconShield, IconTruck } from "../components/icons/ui";
import { configuracionSitio as c } from "../data/configuracion";
import { HISTORIA_DEFECTO, MISION_DEFECTO, VALORES_DEFECTO, VISION_DEFECTO } from "../data/textos-defecto";

// Misión, Visión, Valores e Historia: texto real de "PRESENTACION SKY
// GROUP 2026.pptx" (diapositivas 5, 6 y 7) — usado como fallback si nadie
// editó estos campos todavía desde /admin/configuracion.
const mision = c.mision || MISION_DEFECTO;
const vision = c.vision || VISION_DEFECTO;
const historia = c.historia || HISTORIA_DEFECTO;

// Imágenes referenciales, fijas por ahora — el negocio las va a reemplazar
// directamente subiendo sus propias fotos a estas rutas (no editable desde
// el admin a propósito, para mantener esto simple).
const heroImagen = "/images/hero/auto-real.webp";
const historiaImagen = "/images/nosotros/fachada.webp";

// Franja bajo el hero: mismos textos que la franja de confianza del inicio.
const FRANJA = [
  { icono: IconTruck, titulo: "Envíos a todo el Perú" },
  { icono: IconShield, titulo: "Garantía en productos" },
  { icono: IconChat, titulo: "Atención por WhatsApp" },
  { icono: IconBox, titulo: "Catálogo amplio" },
];

const VALORES = c.valores && c.valores.length > 0 ? c.valores : VALORES_DEFECTO;

// "¿Por qué SKY?" — los 6 bloques visuales que pide la presentación
// (diapositiva 17), con descripciones tal cual las trae la fuente donde
// las hay.
const RAZONES = [
  { titulo: "Amplio portafolio de productos", desc: "Productos y soluciones para diferentes tipos de vehículos.", icono: "caja" },
  { titulo: "Atención personalizada", desc: "Asesoría para ayudarte a encontrar el producto adecuado.", icono: "chat" },
  { titulo: "Calidad y funcionalidad", desc: "Productos seleccionados para responder a diferentes necesidades.", icono: "medalla" },
  { titulo: "Venta mayorista y minorista", desc: "Atendemos tanto a clientes particulares como a negocios y distribuidores.", icono: "tienda" },
  { titulo: "Distribución nacional", desc: "Distribuimos nuestros productos a todo el Perú y fronteras.", icono: "camion" },
  { titulo: "Experiencia en el sector automotriz", desc: "Trayectoria dedicada al mercado automotriz peruano.", icono: "auto" },
];

// Trazos de íconos (24×24, estilo línea). El ícono de cada valor se elige por
// su título; si el negocio agrega un valor nuevo desde el panel, usa "estrella".
const ICONOS: Record<string, string> = {
  diana: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  ojo: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  manos: '<path d="M11 17l2 2a1 1 0 0 0 1.4 0l3.6-3.6a1 1 0 0 0 0-1.4L13 9"/><path d="M14 6l-2-2-6 6 4 4"/><path d="M3 13l3 3"/><path d="M21 13l-3 3"/>',
  medalla: '<circle cx="12" cy="9" r="6"/><path d="M8.5 14 7 22l5-3 5 3-1.5-8"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
  foco: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V16h8v-1.3A7 7 0 0 0 12 2z"/>',
  escudo: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  estrella: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>',
  caja: '<path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>',
  tienda: '<path d="M3 9l1.5-5h15L21 9"/><path d="M4 9v11h16V9"/><path d="M3 9h18"/><path d="M9 20v-6h6v6"/>',
  camion: '<path d="M1 4h14v12H1z"/><path d="M15 9h4l3 3v4h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/>',
  auto: '<path d="M5 17H3v-5l2-5h14l2 5v5h-2"/><path d="M3 12h18"/><circle cx="7.5" cy="17" r="2"/><circle cx="16.5" cy="17" r="2"/>',
};
const iconoValor = (titulo: string) => {
  const t = titulo.toLowerCase();
  if (t.includes("compromiso")) return "manos";
  if (t.includes("calidad")) return "medalla";
  if (t.includes("servicio")) return "chat";
  if (t.includes("innova")) return "foco";
  if (t.includes("confian")) return "escudo";
  return "estrella";
};
const svg = (nombre: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">${ICONOS[nombre]}</svg>`;
---

<Layout title="Nosotros" description="Conoce a SKY Group: misión, visión, valores e historia de la empresa importadora de accesorios y equipamiento vehicular en Lima, Perú.">
  <section class="relative isolate overflow-hidden bg-white dark:bg-neutral-950">
    <img src={heroImagen} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover object-right" />
    <div class="absolute inset-0 -z-10 bg-white/85 sm:hidden dark:bg-neutral-950/85"></div>
    <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-white from-35% via-white/80 to-white/0 sm:block dark:from-neutral-950 dark:via-neutral-950/80 dark:to-neutral-950/10"></div>
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 sm:pb-20 sm:pt-24">
      <div class="max-w-xl">
        <h1 class="bg-gradient-to-r from-brand-blue-dark to-brand-green-dark bg-clip-text pb-1 text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl lg:text-6xl dark:from-brand-blue dark:to-brand-green">Nosotros</h1>
        <p class="mt-4 text-neutral-700 sm:text-lg dark:text-neutral-200">
          Somos una empresa peruana líder en la importación, comercialización
          y distribución de accesorios y equipamiento para vehículos, con
          atención directa y personalizada por WhatsApp para clientes
          mayoristas y minoristas.
        </p>
      </div>
    </div>
    <div class="border-t border-neutral-200/80 bg-white/75 backdrop-blur dark:border-neutral-800 dark:bg-neutral-900/75">
      <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-y-4 px-4 py-5 sm:grid-cols-4 sm:divide-x sm:divide-neutral-200 dark:sm:divide-neutral-800">
        {
          FRANJA.map((f, i) => (
            <li class="flex items-center justify-center gap-3 px-2 text-sm font-semibold text-neutral-800 dark:text-neutral-100">
              <span class={`flex h-9 w-9 flex-none items-center justify-center rounded-full text-white ${i % 2 === 0 ? "bg-brand-blue" : "bg-brand-green"}`}>
                <f.icono class="h-4 w-4" />
              </span>
              {f.titulo}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-12 sm:grid-cols-2 sm:py-16">
    {
      [
        { titulo: "Misión", texto: mision, icono: "diana", color: "blue" },
        { titulo: "Visión", texto: vision, icono: "ojo", color: "green" },
      ].map((b, i) => (
        <div
          data-reveal
          style={`transition-delay: ${i * 120}ms`}
          class="flex gap-5 rounded-lg border border-neutral-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
        >
          <span
            class={`flex h-14 w-14 flex-none items-center justify-center rounded-full text-white shadow-md ${b.color === "blue" ? "bg-brand-blue" : "bg-brand-green"}`}
            set:html={svg(b.icono).replace("h-6 w-6", "h-7 w-7")}
          />
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">{b.titulo}</h2>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{b.texto}</p>
            <span class={`mt-4 block h-1 w-12 rounded-full ${b.color === "blue" ? "bg-brand-blue" : "bg-brand-green"}`}></span>
          </div>
        </div>
      ))
    }
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <div class="grid items-center gap-8 overflow-hidden rounded-lg border border-neutral-200 bg-neutral-50 sm:grid-cols-2 dark:border-neutral-800 dark:bg-neutral-900">
      <div class="p-6 sm:p-10">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-white">Nuestra <span class="text-brand-blue-dark dark:text-brand-blue">historia</span></h2>
        <p data-reveal class="mt-4 text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">{historia}</p>
      </div>
      <div class="relative h-56 sm:h-full sm:min-h-72">
        <img
          src={historiaImagen}
          alt="Fachada de la tienda SKY Group en Av. México, La Victoria"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <h2 class="text-2xl font-bold tracking-tight text-brand-blue-dark sm:text-3xl dark:text-brand-blue">Valores</h2>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {
        VALORES.map((v, i) => (
          <div
            data-reveal
            style={`transition-delay: ${i * 90}ms`}
            class="flex flex-col items-center overflow-hidden rounded-lg border border-neutral-200 bg-white text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
          >
            {v.imagen ? (
              <img src={v.imagen} alt="" class="h-28 w-full object-cover" loading="lazy" />
            ) : (
              <span
                class={`mt-6 flex h-12 w-12 items-center justify-center rounded-full text-white shadow-md ${i % 2 === 0 ? "bg-brand-blue" : "bg-brand-green"}`}
                set:html={svg(iconoValor(v.titulo))}
              />
            )}
            <div class="p-4 pt-3">
              <p class="font-semibold text-neutral-900 dark:text-white">{v.titulo}</p>
              <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{v.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <div class="grid gap-8 rounded-lg border border-brand-blue/20 bg-brand-blue/5 p-6 sm:p-10 lg:grid-cols-[220px_1fr] lg:gap-10 dark:border-neutral-800 dark:bg-neutral-900">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl lg:border-r lg:border-brand-blue/20 lg:pr-8 dark:text-white dark:lg:border-neutral-700">
        ¿Por qué <span class="text-brand-blue-dark dark:text-brand-blue">elegirnos?</span>
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          RAZONES.map((r, i) => (
            <div data-reveal style={`transition-delay: ${i * 90}ms`} class="flex gap-4">
              <span
                class={`flex h-11 w-11 flex-none items-center justify-center rounded-full text-white shadow-md ${i % 2 === 0 ? "bg-brand-blue" : "bg-brand-green"}`}
                set:html={svg(r.icono)}
              />
              <div>
                <p class="font-semibold text-neutral-900 dark:text-white">{r.titulo}</p>
                <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{r.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <MarcasSection />
</Layout>
