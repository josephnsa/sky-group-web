---
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminCatalogos from "../../components/admin/AdminCatalogos";
---

<Layout title="Admin · Catálogos">
  <section class="flex flex-col gap-8 px-4 py-12 sm:flex-row sm:py-16">
    <AdminNav activo="catalogos" />
    <div class="min-w-0 max-w-3xl flex-1">
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
        Catálogos
      </h1>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        Catálogos generales en PDF que se muestran en /catalogos (sin precios).
      </p>
      <div class="mt-8">
        <AdminCatalogos client:only="preact" />
      </div>
    </div>
  </section>
</Layout>
