---
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminCategoriasYProductos from "../../components/admin/AdminCategoriasYProductos";
---

<Layout title="Admin · Categorías">
  <section class="flex flex-col gap-8 px-4 py-12 sm:flex-row sm:py-16">
    <AdminNav activo="categorias" />
    <div class="min-w-0 max-w-4xl flex-1">
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
        Categorías
      </h1>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        Desde acá se agregan categorías, y dentro de cada una sus subcategorías y productos.
      </p>
      <div class="mt-8">
        <AdminCategoriasYProductos client:only="preact" />
      </div>
    </div>
  </section>
</Layout>
