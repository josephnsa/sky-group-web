---
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminConfiguracion from "../../components/admin/AdminConfiguracion";
---

<Layout title="Admin · Configuración">
  <section class="flex flex-col gap-8 px-4 py-12 sm:flex-row sm:py-16">
    <AdminNav activo="configuracion" />
    <div class="min-w-0 max-w-3xl flex-1">
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
        Configuración
      </h1>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        Datos de contacto, redes sociales, logo y foto que se muestran en el pie de página
        de todo el sitio.
      </p>
      <div class="mt-8">
        <AdminConfiguracion client:only="preact" />
      </div>
    </div>
  </section>
</Layout>
