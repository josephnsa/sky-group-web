---
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/admin/AdminNav.astro";
import AdminInicio from "../../components/admin/AdminInicio";
---

<Layout title="Panel de administración">
  <section class="flex flex-col gap-8 px-4 py-12 sm:flex-row sm:py-16">
    <AdminNav activo="inicio" />
    <div class="min-w-0 max-w-3xl flex-1">
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
        Panel de administración
      </h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">
        Gestioná el carrusel de Home, las categorías y los productos del catálogo.
      </p>

      <div class="mt-8">
        <AdminInicio client:only="preact" />
      </div>
    </div>
  </section>
</Layout>
