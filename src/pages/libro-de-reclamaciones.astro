---
import Layout from "../layouts/Layout.astro";
import LibroDeReclamacionesForm from "../components/LibroDeReclamacionesForm";
import { NEGOCIO } from "../consts";
---

<Layout title="Libro de Reclamaciones Virtual">
  <section class="mx-auto max-w-2xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white sm:text-4xl lg:text-5xl">
      Libro de Reclamaciones Virtual
    </h1>
    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
      Conforme a lo establecido en el Código de Protección y Defensa del
      Consumidor (Ley N° 29571) y su reglamento (D.S. N° 011-2011-PCM),
      {" "}{NEGOCIO.razonSocial} (RUC {NEGOCIO.ruc}), con domicilio en{" "}
      {NEGOCIO.direccion}, cuenta con el presente Libro de Reclamaciones
      Virtual a disposición del consumidor.
    </p>

    <div class="mt-8">
      <LibroDeReclamacionesForm client:load />
    </div>
  </section>
</Layout>
