---
import { MARCAS } from "../consts";

interface Props {
  titulo?: string;
}

const { titulo = "Marcas que trabajamos" } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
  <h2 data-reveal class="border-l-4 border-brand-green pl-3 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">{titulo}</h2>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
    {
      MARCAS.map((m, i) => (
        <div
          data-reveal
          style={`transition-delay: ${i * 100}ms`}
          class="group flex flex-col items-center gap-3 rounded-lg border border-neutral-200 bg-white p-6 text-center transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-neutral-800"
        >
          <img
            src={m.logo}
            alt={m.nombre}
            class="h-16 w-auto object-contain transition-transform duration-300 group-hover:scale-110"
            loading="lazy"
          />
          <p class="text-sm text-neutral-500 dark:text-neutral-400">{m.desc}</p>
        </div>
      ))
    }
  </div>
</section>
