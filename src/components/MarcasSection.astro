---
import { MARCAS } from "../consts";

interface Props {
  titulo?: string;
}

const { titulo = "Nuestras marcas" } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
  <h2 data-reveal class="border-l-4 border-brand-green pl-3 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">{titulo}</h2>
  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
    {
      MARCAS.map((m, i) => "lineas" in m && m.lineas ? (
        <div
          data-reveal
          class="col-span-2 grid grid-cols-2 divide-x divide-neutral-200 rounded-lg border border-neutral-200 bg-white transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg sm:col-span-1 dark:divide-neutral-800 dark:border-neutral-800"
        >
          {m.lineas.map((l) => (
            <a
              href={`/catalogo?marca=${encodeURIComponent(m.nombre)}`}
              class="group flex flex-col items-center gap-3 p-4 text-center"
            >
              <img
                src={l.logo}
                alt={l.nombre}
                class="h-14 w-full max-w-[8.5rem] object-contain transition-transform duration-300 group-hover:scale-110"
                loading="lazy"
              />
              <p class="text-xs text-neutral-500 dark:text-neutral-400 sm:text-sm">{l.desc}</p>
            </a>
          ))}
        </div>
      ) : (
        <a
          href={`/catalogo?marca=${encodeURIComponent(m.nombre)}`}
          data-reveal
          style={`transition-delay: ${i * 100}ms`}
          class="group flex flex-col items-center gap-3 rounded-lg border border-neutral-200 bg-white p-4 text-center sm:p-6 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-neutral-800"
        >
          <img
            src={m.logo}
            alt={m.nombre}
            class="h-14 w-full max-w-[8.5rem] object-contain transition-transform duration-300 group-hover:scale-110 sm:h-16 sm:w-auto sm:max-w-none"
            loading="lazy"
          />
          <p class="text-xs text-neutral-500 dark:text-neutral-400 sm:text-sm">{m.desc}</p>
        </a>
      ))
    }
  </div>
</section>
