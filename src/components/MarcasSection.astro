---
import { MARCAS } from "../consts";

interface Props {
  titulo?: string;
}

const { titulo = "Nuestras marcas" } = Astro.props;

// SKY se muestra como dos tarjetas separadas (SKY ACCESSORIES y SKY
// EQUIPMENT); ambas filtran el catálogo por la marca SKY.
const tarjetas = MARCAS.flatMap((m) =>
  "lineas" in m && m.lineas
    ? m.lineas.map((l) => ({ ...l, filtro: m.nombre }))
    : [{ nombre: m.nombre, logo: m.logo, desc: m.desc, filtro: m.nombre }],
);
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
  <h2 data-reveal class="border-l-4 border-brand-green pl-3 text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">{titulo}</h2>
  <div class="mt-6 flex flex-wrap justify-center gap-3 sm:gap-4">
    {
      tarjetas.map((m, i) => (
        <a
          href={`/catalogo?marca=${encodeURIComponent(m.filtro)}`}
          data-reveal
          style={`transition-delay: ${i * 100}ms`}
          class="group flex w-[calc(50%-0.375rem)] flex-col items-center gap-3 overflow-hidden rounded-lg border border-neutral-200 bg-white p-4 text-center transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg sm:w-[calc((100%-2rem)/3)] sm:p-6 lg:w-[calc((100%-3rem)/4)] dark:border-neutral-800"
        >
          <img
            src={m.logo}
            alt={m.nombre}
            class:list={[
              "w-full max-w-full object-contain transition-transform duration-300 group-hover:scale-110",
              // TACPRO es casi cuadrado: con la misma altura que los logos
              // anchos el dibujo queda chico. Un poco más de alto lo acerca
              // al resto, y max-w-full evita que ninguno se salga de la tarjeta.
              m.nombre === "TACPRO"
                ? "h-[4.75rem] sm:h-24"
                : "h-14 sm:h-16",
            ]}
            loading="lazy"
          />
          <p class="text-balance text-[13px] leading-snug text-neutral-900 sm:text-[15px]">{m.desc}</p>
        </a>
      ))
    }
  </div>
</section>
