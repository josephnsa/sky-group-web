---
interface Props {
  activo: "inicio" | "carrusel" | "categorias" | "productos" | "reclamos" | "administradores";
}
const { activo } = Astro.props;

const enlaces = [
  { id: "carrusel", href: "/admin/carrusel", etiqueta: "Carrusel" },
  { id: "categorias", href: "/admin/categorias", etiqueta: "Categorías" },
  { id: "productos", href: "/admin/productos", etiqueta: "Productos" },
  { id: "reclamos", href: "/admin/reclamos", etiqueta: "Reclamos" },
  { id: "administradores", href: "/admin/administradores", etiqueta: "Administradores" },
] as const;
---

<aside
  aria-label="Navegación del panel de administración"
  class="w-full shrink-0 sm:sticky sm:top-[130px] sm:w-52 sm:self-start"
>
  <nav>
    <ul class="flex gap-2 overflow-x-auto sm:flex-col sm:gap-1.5 sm:overflow-visible">
      {enlaces.map((e) => (
        <li>
          <a
            href={e.href}
            aria-current={activo === e.id ? "page" : undefined}
            class={`block shrink-0 rounded-lg border-l-4 px-4 py-3 text-base font-semibold transition-colors duration-200 sm:shrink ${
              activo === e.id
                ? "border-brand-blue bg-brand-blue/5 text-brand-blue-dark dark:bg-brand-blue/10 dark:text-brand-blue"
                : "border-transparent text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white"
            }`}
          >
            {e.etiqueta}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
