---
interface Props {
  activo: "inicio" | "carrusel" | "categorias" | "catalogos" | "reclamos" | "configuracion" | "administradores";
}
const { activo } = Astro.props;

// Íconos de 20×20 (trazo) para cada sección.
const enlaces = [
  { id: "carrusel", href: "/admin/carrusel", etiqueta: "Carrusel", icono: "M3 5h14v10H3zM7 18h6M6 12l3-3 2 2 3-3" },
  { id: "categorias", href: "/admin/categorias", etiqueta: "Categorías y productos", icono: "M3 4h6v6H3zM11 4h6v6h-6zM3 12h6v6H3zM11 12h6v6h-6z" },
  { id: "catalogos", href: "/admin/catalogos", etiqueta: "Catálogos", icono: "M5 2h7l4 4v12H5zM12 2v4h4M8 11h5M8 14h5" },
  { id: "reclamos", href: "/admin/reclamos", etiqueta: "Reclamos", icono: "M4 3h12v12H8l-4 3zM8 8h5M8 11h3" },
  { id: "configuracion", href: "/admin/configuracion", etiqueta: "Configuración", icono: "M10 7a3 3 0 100 6 3 3 0 000-6zM10 1v3M10 16v3M1 10h3M16 10h3M3.6 3.6l2.1 2.1M14.3 14.3l2.1 2.1M3.6 16.4l2.1-2.1M14.3 5.7l2.1-2.1" },
  { id: "administradores", href: "/admin/administradores", etiqueta: "Administradores", icono: "M7 9a3 3 0 100-6 3 3 0 000 6zM1 17c0-3 3-5 6-5s6 2 6 5M14 4a3 3 0 010 5M16 12c2 .6 3 2.4 3 5" },
] as const;
---

<aside
  aria-label="Navegación del panel de administración"
  data-nav-admin
  class="w-full shrink-0 sm:sticky sm:top-[130px] sm:w-44 sm:self-start lg:w-48"
>
  <nav>
    <ul class="flex gap-1.5 overflow-x-auto sm:flex-col sm:gap-1 sm:overflow-visible">
      {enlaces.map((e) => (
        <li>
          <a
            href={e.href}
            title={e.etiqueta}
            aria-current={activo === e.id ? "page" : undefined}
            class={`flex shrink-0 items-center gap-2.5 whitespace-nowrap rounded-lg border-l-4 px-3 py-2 text-sm font-semibold transition-colors duration-200 sm:whitespace-normal ${
              activo === e.id
                ? "border-brand-blue bg-brand-blue/5 text-brand-blue-dark dark:bg-brand-blue/10 dark:text-brand-blue"
                : "border-transparent text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white"
            }`}
          >
            <svg class="h-5 w-5 flex-none" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={e.icono} />
            </svg>
            <span data-nav-texto>{e.etiqueta}</span>
          </a>
        </li>
      ))}
    </ul>
    <button
      type="button"
      data-nav-plegar
      aria-label="Plegar el menú"
      title="Plegar el menú"
      class="mt-3 hidden w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-semibold text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900 sm:flex dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-white"
    >
      <svg class="h-5 w-5 flex-none transition-transform" data-nav-flecha viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 5l-5 5 5 5" />
      </svg>
      <span data-nav-texto>Plegar menú</span>
    </button>
  </nav>
</aside>

<style is:global>
  /* Menú plegado (solo en pantallas medianas y grandes): quedan solo los íconos. */
  @media (min-width: 640px) {
    html[data-admin-nav="plegado"] [data-nav-admin] {
      width: 3.5rem;
    }
    html[data-admin-nav="plegado"] [data-nav-texto] {
      display: none;
    }
    html[data-admin-nav="plegado"] [data-nav-flecha] {
      transform: rotate(180deg);
    }
  }
</style>

<script is:inline>
  (function () {
    function aplicar() {
      var plegado = false;
      try {
        plegado = localStorage.getItem("admin-nav") === "plegado";
      } catch (e) {}
      if (plegado) document.documentElement.setAttribute("data-admin-nav", "plegado");
      else document.documentElement.removeAttribute("data-admin-nav");
      var b = document.querySelector("[data-nav-plegar]");
      if (!b || b.dataset.listo) return;
      b.dataset.listo = "1";
      b.addEventListener("click", function () {
        var ahora = document.documentElement.getAttribute("data-admin-nav") !== "plegado";
        try {
          localStorage.setItem("admin-nav", ahora ? "plegado" : "abierto");
        } catch (e) {}
        aplicar();
        b.setAttribute("aria-label", ahora ? "Mostrar el menú" : "Plegar el menú");
        b.title = ahora ? "Mostrar el menú" : "Plegar el menú";
      });
    }
    aplicar();
    document.addEventListener("astro:page-load", aplicar);
  })();
</script>
