---
import { MEDIOS_DE_PAGO, NEGOCIO, SITE } from "../consts";
import { configuracionSitio as c } from "../data/configuracion";
import { ICONO_POR_RED } from "./icons/redes";

const anio = new Date().getFullYear();
const medios = c.mediosPago && c.mediosPago.length > 0 ? c.mediosPago : MEDIOS_DE_PAGO;
const redesActivas = Object.entries({
  facebook: c.facebook,
  instagram: c.instagram,
  tiktok: c.tiktok,
  youtube: c.youtube,
}).filter(([, url]) => url);
---

<footer class="bg-neutral-900 text-neutral-300">
  <div class="h-1 w-full bg-gradient-to-r from-brand-blue to-brand-green"></div>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:grid-cols-2 sm:py-16 lg:grid-cols-4">
    <div>
      <img src={c.logoUrl} alt={SITE.nombre} class="h-9 w-auto" />
      <p class="mt-3 text-sm text-neutral-400">{SITE.descripcion}</p>
    </div>

    <div>
      <p class="font-semibold text-white">Contacto</p>
      <img
        src={c.fotoFachadaUrl}
        alt={`Fachada de ${SITE.nombre}`}
        class="mt-2 h-24 w-full rounded-lg object-cover"
        loading="lazy"
      />
      <ul class="mt-3 space-y-1 text-sm text-neutral-400">
        <li>Tel: {c.telefono}</li>
        <li>Correo: {c.correo}</li>
        <li>{c.direccion}</li>
      </ul>
      <p class="mt-2 text-xs text-neutral-500">{c.horario}</p>
    </div>

    <div>
      <p class="font-semibold text-white">Medios de pago</p>
      <ul class="mt-2 space-y-1 text-sm text-neutral-400">
        {medios.map((m) => <li>{m}</li>)}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white">Enlaces</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a class="text-neutral-400 transition-colors duration-200 hover:text-brand-blue hover:underline" href="/nosotros">Nosotros</a></li>
        <li><a class="text-neutral-400 transition-colors duration-200 hover:text-brand-blue hover:underline" href="/contacto">Contacto</a></li>
        <li><a class="text-neutral-400 transition-colors duration-200 hover:text-brand-blue hover:underline" href="/medios-de-pago">Medios de pago</a></li>
        <li><a class="text-neutral-400 transition-colors duration-200 hover:text-brand-blue hover:underline" href="/redes-sociales">Redes sociales</a></li>
        <li>
          <a class="font-medium text-white transition-colors duration-200 hover:text-brand-blue hover:underline" href="/libro-de-reclamaciones">
            Libro de Reclamaciones Virtual
          </a>
        </li>
      </ul>
      {redesActivas.length > 0 && (
        <div class="mt-4 flex gap-4">
          {redesActivas.map(([nombre, url]) => {
            const Icono = ICONO_POR_RED[nombre];
            return (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={nombre}
                class="text-neutral-400 transition-colors duration-200 hover:text-brand-blue"
              >
                <Icono class="h-5 w-5" />
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <div class="border-t border-neutral-800 px-4 py-4 text-center text-xs text-neutral-500">
    © {anio} {NEGOCIO.razonSocial}. Todos los derechos reservados.
  </div>
</footer>
