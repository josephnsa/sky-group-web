---
import { IconSun, IconMoon } from "./icons/ui";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar tema claro/oscuro"
  class="rounded-md p-2 text-white/90 sm:p-2.5 transition-colors duration-200 hover:bg-white/15 hover:text-white"
>
  <IconSun class="h-6 w-6 dark:hidden" />
  <IconMoon class="hidden h-6 w-6 dark:block" />
</button>
